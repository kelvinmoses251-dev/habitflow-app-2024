rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A habit belongs to exactly one user and can never be re-assigned to another.
    match /habits/{habitId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create:       if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update:       if request.auth != null
                          && request.auth.uid == resource.data.userId
                          && request.resource.data.userId == resource.data.userId;
    }

    // Profile docs hold the user's email and push-notification token, so only the owner may touch them.
    // (They used to be readable by every signed-in user. The app never reads anyone else's doc;
    //  server-side reminder jobs use the Admin SDK, which bypasses these rules.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
